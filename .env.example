# Postgres-Verbindung (z. B. Neon, Supabase oder lokal)
DATABASE_URL="postgresql://user:passwort@host/datenbank?sslmode=require"

# Passwort für den Admin-/Dozierenden-Bereich unter /admin
ADMIN_PASSWORD="bitte-aendern"

# Zufälliger Schlüssel zum Signieren der Login-Cookies
# erzeugen mit:  openssl rand -base64 32
SESSION_SECRET="bitte-aendern-mindestens-32-zeichen-lang"
